# Copy to .env and fill in. See the README for what each one does.

# Postgres connection string. Anything starting with `postgres` selects the
# Postgres adapter; use `file:./site-test.db` for local SQLite instead.
# Use the pooled Neon endpoint (host contains `-pooler`) for serverless.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs auth tokens. Generate a long random string.
# Environments sharing a database must use the same value, or sessions break.
PAYLOAD_SECRET=

# Guards /next/preview and the dev-only /next/seed route.
PREVIEW_SECRET=

# Origin used by live preview. The deployed URL in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public R2 bucket URL, used for static assets in /public.
# Note the underscore — Netlify rejects hyphens in variable names.
cloudflare_r2=https://pub-xxxxxxxx.r2.dev

# R2 credentials for media uploads. Create an API token in the Cloudflare
# dashboard under R2 → API → Manage API Tokens, with Object Read & Write.
# The bucket name is NOT part of the endpoint.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
